<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.prison_management.PrisonWarden.EmergencyLockdownController">
   <children>
      <Text layoutX="242.0" layoutY="27.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Emergency Lockdown" />
      <CheckBox fx:id="ActivateLockdownCheckBox" layoutX="239.0" layoutY="118.0" mnemonicParsing="false" prefHeight="58.0" prefWidth="134.0" text="Activate Lockdown" />
      <Button layoutX="168.0" layoutY="262.0" mnemonicParsing="false" onAction="#SaveEmergencyLockdownStatusAndApplyOA" prefHeight="47.0" prefWidth="262.0" text="Save Emergency Lockdown Status &amp; Apply">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
      <Button layoutX="24.0" layoutY="28.0" mnemonicParsing="false" onAction="#BackOA" text="Back">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
