<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.prison_management.PrisonWarden.IssueStaffWarningController">
   <children>
      <Text layoutX="249.0" layoutY="27.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Issue Staff Warning" />
      <Text layoutX="40.0" layoutY="84.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Input Employee ID :" />
      <TextField fx:id="InputEmployeeIDTF" layoutX="151.0" layoutY="67.0" />
      <Text layoutX="40.0" layoutY="236.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Warning text :" />
      <TextField fx:id="WarningtextTF" layoutX="57.0" layoutY="252.0" prefHeight="65.0" prefWidth="486.0" />
      <Button layoutX="249.0" layoutY="332.0" mnemonicParsing="false" onAction="#SendWarningOA" prefHeight="47.0" prefWidth="120.0" text="Send Warning">
         <font>
            <Font name="System Bold" size="12.0" />
         </font></Button>
      <Button layoutX="24.0" layoutY="28.0" mnemonicParsing="false" onAction="#BackOA" text="Back">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
      <Label fx:id="LastWarningLabel" layoutX="57.0" layoutY="133.0" prefHeight="66.0" prefWidth="486.0" text="Last Warning ;" />
      <Button layoutX="403.0" layoutY="67.0" mnemonicParsing="false" onAction="#ShowlastWarningOA" text="Show last Warning">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Button>
   </children>
</AnchorPane>
