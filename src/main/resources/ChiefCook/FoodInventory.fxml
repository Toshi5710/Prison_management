      <TableView fx:id="FoodInventoryTV" layoutX="51.0" layoutY="162.0" prefHeight="200.0" prefWidth="444.0">
        <columns>
          <TableColumn fx:id="ItemIDTC" prefWidth="75.0" text="Item ID" />
          <TableColumn fx:id="ItemNameTC" prefWidth="75.0" text="Item Name" />
            <TableColumn fx:id="CurrentStockTC" prefWidth="122.4000244140625" text="Current Stock" />
            <TableColumn fx:id="MinimumRequiredStockTC" prefWidth="170.39996337890625" text="Minimum Required Stock" />
        </columns>
      </TableView>
      <Button layoutX="471.0" layoutY="36.0" mnemonicParsing="false" onAction="#FetchFoodStockButtonOA" text="Fetch Food Stock" />
      <Button layoutX="471.0" layoutY="106.0" mnemonicParsing="false" onAction="#UpdateInventoryButtonOA" text="Update Inventory" />
   </children>
</AnchorPane>
