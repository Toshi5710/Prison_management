<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>


<AnchorPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.prison_management.ChiefCook.FoodConsumptionReportsViewController">
   <children>
      <DatePicker fx:id="EndDateDP" layoutX="394.0" layoutY="64.0" />
      <DatePicker fx:id="StartDateDP" layoutX="394.0" layoutY="15.0" />
      <Label layoutX="332.0" layoutY="68.0" text="End Date" />
      <ComboBox fx:id="CatagoryCB" layoutX="150.0" layoutY="15.0" prefWidth="150.0" promptText="Catagory" />
      <Label layoutX="330.0" layoutY="19.0" text="Start Date" />
      <TableView fx:id="ConsumptionMetricsAndLogsTV" layoutX="21.0" layoutY="100.0" prefHeight="200.0" prefWidth="200.0">
        <columns>
          <TableColumn fx:id="ConsumptionMetricsAndLogsTV" prefWidth="75.0" text="C1" />
          <TableColumn prefWidth="75.0" text="C2" />
        </columns>
      </TableView>
      <Button layoutX="420.0" layoutY="156.0" mnemonicParsing="false" onAction="#FetchConsumptionRecordsButtonOA" text="Fetch Consumption Records" />
      <Button layoutX="442.0" layoutY="214.0" mnemonicParsing="false" onAction="#GenerateReportButtonOA" text="Generate Report" />
      <Label fx:id="ConsumptionmetricsandlogsTV" layoutX="21.0" layoutY="68.0" text="Consumption metrics and logs" />
      <Label layoutX="26.0" layoutY="315.0" text="Report generated notification" />
   </children>
</AnchorPane>
